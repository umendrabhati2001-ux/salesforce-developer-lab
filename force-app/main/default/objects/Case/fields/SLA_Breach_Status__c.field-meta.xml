<?xml version="1.0" encoding="UTF-8" ?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>SLA_Breach_Status__c</fullName>
    <description
  >Calculates SLA status dynamically based on CreatedDate and Target SLA Hours</description>
    <externalId>false</externalId>
    <formula
  >IF(IsClosed, "RESOLVED", IF(NOW() &gt; CreatedDate + (BLANKVALUE(Resolution_SLA_Hours__c, 24) / 24), "BREACHED", "ON TRACK"))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>SLA Breach Status</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
